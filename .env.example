# ----------------------------------------------------------------------------
# Authentication (static credentials for the login page)
# ----------------------------------------------------------------------------
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-me
# Must be at least 32 characters. Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Login rate-limit (optional, defaults shown).
# LOGIN_MAX_FAILURES failures within LOGIN_WINDOW_MINUTES = lockout for LOGIN_LOCKOUT_MINUTES.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=5

# Timeout (ms) for outbound Playground batch-scheduler HTTP calls.
PLAYGROUND_FETCH_TIMEOUT_MS=10000

# ----------------------------------------------------------------------------
# Playground batch scheduler API (DELETE EventBridge schedulers).
# The SQS delete / changeVisibility actions used to go through a Playground
# API too — they have been migrated to direct AWS SDK calls (see AWS SQS
# section below). The batch scheduler still goes through the Playground HTTP
# API.
# ----------------------------------------------------------------------------
PLAYGROUND_SQS_BATCH_API_URL=
PLAYGROUND_SQS_BATCH_API_KEY=

# ============================================================================
# AWS SQS — direct integration (clear / refire actions)
# Two AWS accounts are involved for the shared queues: one per environment
# (prod and stage). Each account hosts both the Corp and the shared OMS
# queues, so credentials are scoped per-env, not per-service.
# Region defaults to ap-south-1; override per-env with {ENV}_AWS_REGION.
# ============================================================================

# Prod AWS credentials (used for CORP_PROD + OMS_PROD queues)
PROD_AWS_ACCESS_KEY_ID=
PROD_AWS_SECRET_ACCESS_KEY=
# PROD_AWS_REGION=ap-south-1

# Stage AWS credentials (used for CORP_STAGE + OMS_STAGE queues)
STAGE_AWS_ACCESS_KEY_ID=
STAGE_AWS_SECRET_ACCESS_KEY=
# STAGE_AWS_REGION=ap-south-1

# Shared queue URLs — one per (service, environment).
CORP_PROD_SQS_QUEUE_URL=
CORP_STAGE_SQS_QUEUE_URL=
OMS_PROD_SQS_QUEUE_URL=
OMS_STAGE_SQS_QUEUE_URL=

# ============================================================================
# SHARED DATABASES — one set per (service, environment)
# Key shape: {SERVICE}_{ENV}_DB_*
# ============================================================================

# Corp DB — Production
CORP_PROD_DB_HOST=
CORP_PROD_DB_USER=
CORP_PROD_DB_PASSWORD=
CORP_PROD_DB_NAME=

# Corp DB — Stage
CORP_STAGE_DB_HOST=
CORP_STAGE_DB_USER=
CORP_STAGE_DB_PASSWORD=
CORP_STAGE_DB_NAME=

# OMS DB — Production (shared instance — used when no private instance is selected)
OMS_PROD_DB_HOST=
OMS_PROD_DB_USER=
OMS_PROD_DB_PASSWORD=
OMS_PROD_DB_NAME=

# OMS DB — Stage (shared instance)
OMS_STAGE_DB_HOST=
OMS_STAGE_DB_USER=
OMS_STAGE_DB_PASSWORD=
OMS_STAGE_DB_NAME=

# ============================================================================
# AUTH DB — V1 auth-backend database (the Corp DB where the user-login tables
# live: Admin_Users, Field_Force_Users, Counter_Company_Lnk, Delegate_Users,
# Stockists). Used ONLY by the "24h OTP Block" tab to clear otp_retry_count +
# lockup_date. One set per environment. Key shape: AUTH_{ENV}_DB_*.
#   SCHEMA is optional (defaults to public) — set it if the auth-backend uses a
#   non-public POSTGRES_SCHEMA for that env (the tab schema-qualifies its query).
# ============================================================================

# Auth DB — Production
AUTH_PROD_DB_HOST=
AUTH_PROD_DB_USER=
AUTH_PROD_DB_PASSWORD=
AUTH_PROD_DB_NAME=
# AUTH_PROD_DB_SCHEMA=public

# Auth DB — Stage
AUTH_STAGE_DB_HOST=
AUTH_STAGE_DB_USER=
AUTH_STAGE_DB_PASSWORD=
AUTH_STAGE_DB_NAME=
# AUTH_STAGE_DB_SCHEMA=public

# ============================================================================
# AWS COGNITO — Auth Details Comparison tab (READ-ONLY ListUsers lookups).
# One field-force user pool per environment. AWS credentials + region are
# REUSED from the SQS section above ({ENV}_AWS_ACCESS_KEY_ID /
# {ENV}_AWS_SECRET_ACCESS_KEY / {ENV}_AWS_REGION) — those IAM credentials must
# also be granted `cognito-idp:ListUsers` on the user pool below.
# ============================================================================
PROD_COGNITO_USERPOOL_ID=
STAGE_COGNITO_USERPOOL_ID=

# ============================================================================
# PRIVATE INSTANCES — register one or more separately-deployed instances of a
# service (each in its own AWS account, with its own DB and SQS queues). The
# UI's "Instance" selector is built dynamically from this list, so adding a
# new instance requires only env changes (no code).
#
# 1) List the instance ids you want to register (comma-separated, lowercase).
# 2) For each id, define a block of vars using PRIVATE_INSTANCE_{ID}_*.
#
# To add a NEW instance later: append its id to PRIVATE_INSTANCES, add a new
# block below — no code changes required.
# ============================================================================
PRIVATE_INSTANCES=lupin

# --- Lupin (OMS private instance) -------------------------------------------
PRIVATE_INSTANCE_LUPIN_LABEL=Lupin
# Which service this instance belongs to (corp or oms).
PRIVATE_INSTANCE_LUPIN_SERVICE=oms

# DB credentials per environment
PRIVATE_INSTANCE_LUPIN_PROD_DB_HOST=
PRIVATE_INSTANCE_LUPIN_PROD_DB_USER=
PRIVATE_INSTANCE_LUPIN_PROD_DB_PASSWORD=
PRIVATE_INSTANCE_LUPIN_PROD_DB_NAME=

PRIVATE_INSTANCE_LUPIN_STAGE_DB_HOST=
PRIVATE_INSTANCE_LUPIN_STAGE_DB_USER=
PRIVATE_INSTANCE_LUPIN_STAGE_DB_PASSWORD=
PRIVATE_INSTANCE_LUPIN_STAGE_DB_NAME=

# SQS queue URL per environment (different queue per env).
PRIVATE_INSTANCE_LUPIN_PROD_SQS_QUEUE_URL=
PRIVATE_INSTANCE_LUPIN_STAGE_SQS_QUEUE_URL=

# AWS credentials — shared across both environments (the instance lives in a
# single AWS account that hosts both stage and prod queues).
# Region is optional; defaults to ap-south-1.
PRIVATE_INSTANCE_LUPIN_AWS_ACCESS_KEY_ID=
PRIVATE_INSTANCE_LUPIN_AWS_SECRET_ACCESS_KEY=
# PRIVATE_INSTANCE_LUPIN_AWS_REGION=ap-south-1

# --- Example: adding a second instance --------------------------------------
# 1) Add its id to PRIVATE_INSTANCES, e.g.   PRIVATE_INSTANCES=lupin,alpha
# 2) Define the block below (uncomment and fill in):
#
# PRIVATE_INSTANCE_ALPHA_LABEL=Alpha Pharma
# PRIVATE_INSTANCE_ALPHA_SERVICE=oms
# PRIVATE_INSTANCE_ALPHA_PROD_DB_HOST=
# PRIVATE_INSTANCE_ALPHA_PROD_DB_USER=
# PRIVATE_INSTANCE_ALPHA_PROD_DB_PASSWORD=
# PRIVATE_INSTANCE_ALPHA_PROD_DB_NAME=
# PRIVATE_INSTANCE_ALPHA_STAGE_DB_HOST=
# PRIVATE_INSTANCE_ALPHA_STAGE_DB_USER=
# PRIVATE_INSTANCE_ALPHA_STAGE_DB_PASSWORD=
# PRIVATE_INSTANCE_ALPHA_STAGE_DB_NAME=
# PRIVATE_INSTANCE_ALPHA_PROD_SQS_QUEUE_URL=
# PRIVATE_INSTANCE_ALPHA_STAGE_SQS_QUEUE_URL=
# PRIVATE_INSTANCE_ALPHA_AWS_ACCESS_KEY_ID=
# PRIVATE_INSTANCE_ALPHA_AWS_SECRET_ACCESS_KEY=
# PRIVATE_INSTANCE_ALPHA_AWS_REGION=ap-south-1
